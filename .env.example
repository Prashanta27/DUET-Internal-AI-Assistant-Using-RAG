# Copy to .env and edit. .env is git-ignored and must never be committed.

APP_ENV=dev
DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_real_random_value_at_least_32_chars

# --- database ---
DATABASE_URL=postgresql+psycopg://duet:duet@localhost:5433/duet
TEST_DATABASE_URL=postgresql+psycopg://duet:duet@localhost:5433/duet_test
DB_ECHO=false

# --- LLM: swap freely, costs nothing ---
LLM_BACKEND=ollama
LLM_MODEL=llama3.2:3b            # laptop, plumbing only -- never report quality from this tier
# LLM_MODEL=qwen3:32b            # server
OLLAMA_HOST=http://localhost:11434
# Inside docker on Windows/macOS use: http://host.docker.internal:11434

# --- embeddings: changing these costs a full reindex ---
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_DIM=1024               # must match the schema
EMBEDDING_REV=1                  # bump to force re-embedding
EMBEDDING_DEVICE=cpu             # cuda on the server
EMBEDDING_BATCH_SIZE=8

# --- reranker: free to toggle, query-time only ---
RERANKER_ENABLED=false           # laptop: off, too slow on CPU
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- ingestion ---
OCR_ENGINE=tesseract
OCR_LANGS=ben+eng
INGEST_DIGITAL_ONLY=true         # M1 default; false from M3

# --- logging ---
LOG_QUERY_TEXT=false
LOG_LEVEL=INFO
